# ==============================================================================
# VendorIQ Backend Environment Configuration Template (.env.example)
# ==============================================================================

APP_NAME="VendorIQ Backend"
ENVIRONMENT="development"
DEBUG=True
API_PREFIX="/api"

# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://<user>:<password>@<neon-hostname>/vendoriq?sslmode=require"

# JWT Authentication
SECRET_KEY="your-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kimi K3 External Reasoning Layer
KIMI_API_KEY="your-kimi-moonshot-api-key"
KIMI_API_BASE="https://api.moonshot.cn/v1"
KIMI_MODEL="moonshot-v1-8k"
KIMI_TIMEOUT_SECONDS=30.0

# Google SMTP Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
