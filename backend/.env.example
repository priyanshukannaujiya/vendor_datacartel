DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/vendoriq?sslmode=require
JWT_SECRET=your-production-jwt-secret-key-min-32-chars
KIMI_API_KEY=your-kimi-moonshot-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-account@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-google-account@gmail.com
SMTP_FROM_NAME=VendorIQ
# Optional inbound supplier PDF replies. Enable IMAP for the Google account first.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-google-account@gmail.com
IMAP_PASSWORD=your-google-app-password
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=120
IMAP_LOOKBACK_DAYS=30
FRONTEND_URL=https://vendoriq.vercel.app
CORS_ORIGINS=["https://vendoriq.vercel.app","http://localhost:5173"]
JWT_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
